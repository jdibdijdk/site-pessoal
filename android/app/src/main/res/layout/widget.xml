<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_bg" android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/w_tx" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_mut" android:textSize="12sp" android:layout_marginEnd="6dp" />
        <ImageView android:id="@+id/refresh" android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_refresh" android:contentDescription="Atualizar" />
    </LinearLayout>

    <ProgressBar android:id="@+id/bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:max="100" android:progress="0" android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="6dp">
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="@color/w_mut" android:textSize="13sp" android:text="@string/carregando" />
        <LinearLayout android:id="@+id/r0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone">
            <ImageView android:id="@+id/r0d" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="10dp" android:src="@drawable/w_dot" />
            <TextView android:id="@+id/r0t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_tx" android:textSize="14sp" />
            <TextView android:id="@+id/r0m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="@color/w_mut" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone">
            <ImageView android:id="@+id/r1d" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="10dp" android:src="@drawable/w_dot" />
            <TextView android:id="@+id/r1t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_tx" android:textSize="14sp" />
            <TextView android:id="@+id/r1m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="@color/w_mut" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone">
            <ImageView android:id="@+id/r2d" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="10dp" android:src="@drawable/w_dot" />
            <TextView android:id="@+id/r2t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_tx" android:textSize="14sp" />
            <TextView android:id="@+id/r2m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="@color/w_mut" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/r3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone">
            <ImageView android:id="@+id/r3d" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="10dp" android:src="@drawable/w_dot" />
            <TextView android:id="@+id/r3t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_tx" android:textSize="14sp" />
            <TextView android:id="@+id/r3m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="@color/w_mut" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/r4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone">
            <ImageView android:id="@+id/r4d" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="10dp" android:src="@drawable/w_dot" />
            <TextView android:id="@+id/r4t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_tx" android:textSize="14sp" />
            <TextView android:id="@+id/r4m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="@color/w_mut" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/r5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone">
            <ImageView android:id="@+id/r5d" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="10dp" android:src="@drawable/w_dot" />
            <TextView android:id="@+id/r5t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_tx" android:textSize="14sp" />
            <TextView android:id="@+id/r5m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="@color/w_mut" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/foot" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/w_mut" android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
