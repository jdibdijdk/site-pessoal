+/// The `postMessage` bridge to a same-origin parent page. Messages are plain objects with a `type`:
+///
+/// - `deckcraft:ready` (to the parent): the app is listening.
+/// - `deckcraft:open` (from the parent): `{ name, bytes }`, a .pptx (or .deckcraft) as an `ArrayBuffer` or `Uint8Array`.
+/// - `deckcraft:new` (from the parent): start an empty presentation.
+/// - `deckcraft:save` (to the parent): `{ name, bytes }` when the user saves; `bytes` is a transferred `ArrayBuffer` (.pptx).
+/// - `deckcraft:dirty` (to the parent): `{ dirty }` whenever unsaved work appears or goes away.
+///
+/// Only a parent window on the app's own origin is heard or answered.
+mod host {
+    use super::{HostRequest, HostRequests};
+    use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+
+    #[derive(Clone)]
+    pub struct Bridge {
+        window: web_sys::Window,
+        parent: web_sys::Window,
+        origin: String,
+    }
+
+    impl Bridge {
+        /// `None` when the page isn't framed or the parent is on another origin.
+        pub fn new() -> Option<Self> {
+            let window = web_sys::window()?;
+            let parent = window.parent().ok().flatten()?;
+            if js_sys::Object::is(&parent, &window) {
+                return None;
+            }
+            let origin = window.location().origin().ok()?;
+            if parent.location().origin().ok()? != origin {
+                return None;
+            }
+            Some(Self { window, parent, origin })
+        }
+
+        fn post(&self, message: &js_sys::Object, transfer: Option<&JsValue>) -> Result<(), String> {
+            let sent = match transfer {
+                Some(t) => self.parent.post_message_with_transfer(message, &self.origin, &js_sys::Array::of1(t)),
+                None => self.parent.post_message(message, &self.origin),
+            };
+            sent.map_err(|e| e.as_string().unwrap_or_else(|| format!("{e:?}")))
+        }
+
+        pub fn post_ready(&self) {
+            if let Some(m) = message(&[("type", "deckcraft:ready".into()), ("version", env!("CARGO_PKG_VERSION").into())]) {
+                let _ = self.post(&m, None);
+            }
+        }
+
+        pub fn post_dirty(&self, dirty: bool) {
+            if let Some(m) = message(&[("type", "deckcraft:dirty".into()), ("dirty", dirty.into())]) {
+                let _ = self.post(&m, None);
+            }
+        }
+
+        pub fn save_fn(&self) -> Box<dyn FnMut(&str, &[u8])> {
+            let bridge = self.clone();
+            Box::new(move |name: &str, bytes: &[u8]| {
+                let buffer = js_sys::Uint8Array::from(bytes).buffer();
+                if let Some(m) = message(&[("type", "deckcraft:save".into()), ("name", name.into()), ("bytes", buffer.clone().into())])
+                    && let Err(e) = bridge.post(&m, Some(&buffer))
+                {
+                    log::error!("deckcraft:save failed: {e}");
+                }
+            })
+        }
+
+        /// Hear `deckcraft:open` and `deckcraft:new` from the parent and queue them for the next frame.
+        pub fn listen(&self, requests: HostRequests, ctx: egui::Context) {
+            let parent = self.parent.clone();
+            let origin = self.origin.clone();
+            let on_message = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |event: web_sys::MessageEvent| {
+                if event.origin() != origin || !event.source().is_some_and(|s| js_sys::Object::is(&s, &parent)) {
+                    return;
+                }
+                let data = event.data();
+                let request = match string(&data, "type").as_deref() {
+                    Some("deckcraft:new") => HostRequest::New,
+                    Some("deckcraft:open") => {
+                        let name = string(&data, "name").filter(|n| !n.trim().is_empty()).unwrap_or_else(|| "presentation.pptx".to_string());
+                        let Ok(bytes) = js_sys::Reflect::get(&data, &JsValue::from_str("bytes")) else { return };
+                        let bytes = if let Some(array) = bytes.dyn_ref::<js_sys::Uint8Array>() {
+                            array.to_vec()
+                        } else if bytes.is_instance_of::<js_sys::ArrayBuffer>() {
+                            js_sys::Uint8Array::new(&bytes).to_vec()
+                        } else {
+                            return;
+                        };
+                        HostRequest::Open { name, bytes }
+                    }
+                    _ => return,
+                };
+                requests.lock().unwrap_or_else(|e| e.into_inner()).push(request);
+                ctx.request_repaint();
+            });
+            if self.window.add_event_listener_with_callback("message", on_message.as_ref().unchecked_ref()).is_ok() {
+                on_message.forget();
+            }
+        }
+    }
+
+    fn message(fields: &[(&str, JsValue)]) -> Option<js_sys::Object> {
+        let m = js_sys::Object::new();
+        for (key, value) in fields {
+            js_sys::Reflect::set(&m, &JsValue::from_str(key), value).ok()?;
+        }
+        Some(m)
+    }
+
+    fn string(data: &JsValue, key: &str) -> Option<String> {
+        js_sys::Reflect::get(data, &JsValue::from_str(key)).ok()?.as_string()
+    }
+}
