@@ -485,6 +486,24 @@ impl eframe::App for PdfCraftApp {
             if let Some(report) = self.host_dirty.as_mut() {
                 report(dirty);
             }
+            // Embedded in a host page: save on its own a moment after the first change, with no Ctrl+S.
+            if self.host_save.is_some() {
+                let now = web_time::Instant::now();
+                let wait = std::time::Duration::from_millis(2500);
+                if !dirty {
+                    self.host_autosave_at = None;
+                } else if let Some(at) = self.host_autosave_at {
+                    if now >= at {
+                        self.host_autosave_at = None;
+                        self.run_command("file.save");
+                    } else {
+                        ctx.request_repaint_after(at - now);
+                    }
+                } else {
+                    self.host_autosave_at = Some(now + wait);
+                    ctx.request_repaint_after(wait);
+                }
+            }
         }
         self.poll_updates();
         self.poll_print();
